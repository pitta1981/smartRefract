<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN"
                            "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="xml">
        <folder name="entities">
            <folder name="org_myorg_myviewer">
                <file name="MyViewer" url="nbres:/org/netbeans/modules/settings/resources/properties-1_0.dtd">
                    <!--org.myorg.myviewer.MyViewerTopComponent-->
                    <attr name="hint.originalPublicID" stringvalue="-//org.myorg.myviewer//MyViewer//EN"/>
                </file>
            </folder>
        </folder>
        <folder name="memory">
            <folder name="org">
                <folder name="myorg">
                    <folder name="myviewer">
                        <file name="MyViewerTopComponent">
                            <!--org.myorg.myviewer.MyViewerTopComponent-->
                            <attr name="settings.providerPath" stringvalue="xml/lookups//org_myorg_myviewer/MyViewer.instance"/>
                        </file>
                    </folder>
                </folder>
            </folder>
        </folder>
        <folder name="lookups">
            <folder name="org_myorg_myviewer">
                <file name="MyViewer.instance">
                    <!--org.myorg.myviewer.MyViewerTopComponent-->
                    <attr
                        methodvalue="org.netbeans.api.settings.Factory.create" name="instanceCreate"/>
                    <attr
                        methodvalue="org.netbeans.api.settings.Factory.properties" name="settings.convertor"/>
                    <attr name="settings.instanceClass" stringvalue="org.myorg.myviewer.MyViewerTopComponent"/>
                    <attr name="settings.instanceOf" stringvalue="org.myorg.myviewer.MyViewerTopComponent"/>
                    <attr boolvalue="true" name="xmlproperties.preventStoring"/>
                </file>
            </folder>
        </folder>
    </folder>
</filesystem>
